{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/about(\\.html|\\.php)?",
      "dest": "/about.html"
    },
    {
      "src": "/services(\\.html|\\.php)?",
      "dest": "/services.html"
    },
    {
      "src": "/products(\\.html|\\.php)?",
      "dest": "/products.html"
    },
    {
      "src": "/contact(\\.html|\\.php)?",
      "dest": "/contact.html"
    },
    {
      "src": "/index(\\.html|\\.php)?",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
